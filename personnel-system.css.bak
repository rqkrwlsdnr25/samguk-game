.personnel-submenu{display:grid;gap:12px;padding:12px;border:1px solid #6d5f43;border-radius:8px;background:linear-gradient(180deg,#1a1813,#101519)}
.personnel-submenu-head{display:flex;justify-content:space-between;align-items:flex-end;border-bottom:1px solid #554b38;padding-bottom:8px}.personnel-submenu-head span{font:700 10px/1 serif;color:#bba36d;letter-spacing:.18em}.personnel-submenu-head h3{margin:2px 0 0;color:#f2deb0}.personnel-submenu-head small{color:#8f9a96}
.personnel-actions{display:grid;grid-template-columns:1fr 1fr;gap:9px}.personnel-actions button{min-height:76px;text-align:left;padding:11px;border:1px solid #665a44;background:#161d20;color:#ede8dc;border-radius:6px}.personnel-actions b{display:block;color:#f0d38f;font-size:14px}.personnel-actions small{display:block;margin-top:5px;color:#9ba6a1;line-height:1.35}.personnel-actions .personnel-search-btn.ready{border-color:#8a7040;background:linear-gradient(180deg,#211b11,#171a19)}.personnel-actions .personnel-search-btn.locked{border-color:#4d5353;filter:saturate(.55)}
.personnel-rates{font-size:10px;line-height:1.6;color:#b9c1bc;background:#0b1114;padding:8px;border-radius:5px}.personnel-rates b{color:#d8c698}.personnel-rates small{color:#7f8985}
.personnel-dialog{width:min(920px,calc(100vw - 28px));max-height:min(82vh,820px);padding:0;border:1px solid #87724c;border-radius:10px;background:#10171a;color:#eee8dc;box-shadow:0 30px 100px #000d}.personnel-dialog::backdrop{background:#05090bbd;backdrop-filter:blur(2px)}.personnel-shell{padding:18px}.personnel-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;padding-bottom:12px;border-bottom:1px solid #66583e}.personnel-head span{font-size:10px;color:#bda66e;letter-spacing:.14em}.personnel-head h2{margin:3px 0;color:#f2deb0}.personnel-head button,.personnel-result-card button{padding:8px 13px;border:1px solid #6e624c;border-radius:5px;background:#20282a;color:#eee8dc}.personnel-list-summary{padding:10px 2px;color:#aeb7b3}.personnel-table-wrap{max-height:62vh;overflow:auto;border:1px solid #394449;border-radius:6px}.personnel-table{width:100%;border-collapse:collapse;font-size:12px}.personnel-table th{position:sticky;top:0;background:#172126;z-index:2;padding:0;border-bottom:1px solid #4d5b60}.personnel-sort{width:100%;padding:9px 7px;border:0;background:none;color:#c8d0cb;font-weight:700}.personnel-sort.active{color:#f1cf7e}.personnel-table td{padding:8px;border-bottom:1px solid #273238;text-align:center}.personnel-table td:first-child{text-align:left}.personnel-table tr{cursor:pointer}.personnel-table tbody tr:hover{background:#ffffff09}.personnel-table td small{display:block;margin-top:2px;font-size:9px}.grade-human{color:#c7c9c8}.grade-earth{color:#6fb4d7}.grade-heaven{color:#bd82ff}.grade-divine{color:#ffd55f}.grade-immortal{color:#d8ffff}
.personnel-result{width:min(560px,calc(100vw - 32px));overflow:visible;background:transparent;border:0;box-shadow:none}.personnel-result::backdrop{background:#040709cc}.personnel-result-card{position:relative;overflow:hidden;text-align:center;padding:28px 24px 22px;border:2px solid #8d8d8d;border-radius:14px;background:radial-gradient(circle at 50% 10%,#34383a,#14191b 55%,#0b0e10);box-shadow:0 24px 80px #000d;animation:personnelReveal .48s cubic-bezier(.18,.85,.28,1.18)}.personnel-grade{font:900 19px/1 serif;letter-spacing:.08em}.personnel-name{margin-top:9px;font-size:34px;font-weight:900;color:#f7f1e7;text-shadow:0 2px 5px #000}.personnel-role{margin-top:5px;color:#b9c1bd}.personnel-main-stat{margin:18px auto 10px;font-size:18px}.personnel-main-stat b{font-size:34px;margin-left:6px}.personnel-result-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin:12px 0}.personnel-result-stats span{padding:8px 4px;border:1px solid #ffffff19;border-radius:6px;background:#0004;color:#aeb8b4}.personnel-result-stats b{display:block;margin-top:2px;color:#fff;font-size:17px}.personnel-result-card p{color:#aeb7b3}.personnel-result-card.grade-earth{border-color:#55a9d1;box-shadow:0 0 28px #4aa9d455,0 24px 80px #000d}.personnel-result-card.grade-earth:after{content:'';position:absolute;inset:-100%;background:linear-gradient(110deg,transparent 46%,#c8ffff44 50%,transparent 54%);animation:personnelShine 2.2s linear infinite}.personnel-result-card.grade-heaven{border-color:#b86cff;box-shadow:0 0 42px #a24aff88,0 24px 80px #000d;animation:personnelReveal .48s cubic-bezier(.18,.85,.28,1.18),personnelPulse 1.15s ease-in-out infinite alternate}.personnel-result-card.grade-divine{border-color:#ffd34f;background:radial-gradient(circle,#5a3a0b,#1c1509 58%,#090806);box-shadow:0 0 65px #ffca46aa,0 24px 90px #000e}.personnel-result-card.grade-divine .personnel-cutin-aura{position:absolute;inset:-25%;background:conic-gradient(from 0deg,transparent,#ffcf5530,transparent,#fff0a022,transparent);animation:personnelAura 2.5s linear infinite}.personnel-result-card.grade-immortal{border-color:#d8ffff;background:radial-gradient(circle at 50% 10%,#e8ffff38,#183647 36%,#111129 70%,#05070c);box-shadow:0 0 90px #9cfaff9c,0 0 35px #c292ff99,0 25px 100px #000}.personnel-result-card.grade-immortal:before{content:'';position:absolute;inset:-35%;background:conic-gradient(#55e8ff33,#d7a1ff44,#80ffce33,#ffffff36,#55e8ff33);filter:blur(22px);animation:personnelAura 3s linear infinite}.personnel-result-card>*{position:relative;z-index:2}
.personnel-screen-shake{animation:personnelScreenShake .55s linear}.personnel-immortal-dim:before{content:'';position:fixed;inset:0;z-index:9998;pointer-events:none;background:#000;animation:personnelDim .85s ease both}
@keyframes personnelReveal{0%{opacity:0;transform:translateY(16px) scale(.72)}70%{opacity:1;transform:translateY(-2px) scale(1.04)}100%{transform:none}}
@keyframes personnelShine{to{transform:translateX(50%)}}
@keyframes personnelPulse{from{filter:brightness(1)}to{filter:brightness(1.22) drop-shadow(0 0 9px #b873ff)}}
@keyframes personnelAura{to{transform:rotate(360deg)}}
@keyframes personnelScreenShake{0%,100%{transform:none}15%{transform:translate(5px,-2px)}30%{transform:translate(-5px,3px)}45%{transform:translate(4px,2px)}60%{transform:translate(-3px,-2px)}75%{transform:translate(2px,1px)}}
@keyframes personnelDim{0%{opacity:0}35%{opacity:.92}100%{opacity:.72}}
@media(max-width:720px){.personnel-actions{grid-template-columns:1fr}.personnel-table{min-width:700px}.personnel-result-stats{grid-template-columns:repeat(2,1fr)}}
@media(prefers-reduced-motion:reduce){.personnel-result-card,.personnel-result-card:before,.personnel-result-card:after,.personnel-screen-shake{animation:none!important}}

/* v79 - player-faction-only officer gallery */
#personnelListDialog.personnel-owned-dialog{width:min(1180px,calc(100vw - 26px));max-height:min(92vh,940px);overflow:hidden;border-color:#b08b42;background:linear-gradient(180deg,#15201d,#0d1414 76%);box-shadow:0 34px 120px #000e,0 0 0 1px #d6b96622 inset}
#personnelListDialog.personnel-owned-dialog::backdrop{background:rgba(2,7,8,.82);backdrop-filter:blur(3px)}
.personnel-owned-dialog .personnel-shell{padding:20px 24px 24px;max-height:92vh;display:flex;flex-direction:column;box-sizing:border-box}
.personnel-owned-head{flex:0 0 auto;align-items:center;background:linear-gradient(90deg,#13231c,#1d2b22 52%,#13201b);padding:4px 4px 14px}
.personnel-owned-head h2{font-family:Georgia,'Noto Serif KR','Nanum Myeongjo',serif;font-size:25px;letter-spacing:.03em;color:#f3dfab;text-shadow:0 1px 9px #000}
.personnel-owned-head p{margin:5px 0 0;color:#98a69f;font-size:11px}
.personnel-owned-head button{border-color:#887142;background:#1d2925;color:#ead7a7}
.personnel-owned-body{min-height:0;overflow:auto;padding:16px 5px 8px;scrollbar-color:#8d7548 #0c1312}
.my-officer-summary{display:flex;justify-content:space-between;align-items:end;gap:18px;margin:0 3px 15px;padding:0 2px 12px;border-bottom:1px solid #8b71484d}
.my-officer-summary>div{display:grid;gap:3px}.my-officer-summary span{font:700 9px/1 Georgia,serif;letter-spacing:.18em;color:#9fcbb4}.my-officer-summary b{font:800 16px/1.2 'Noto Serif KR','Nanum Myeongjo',serif;color:#f1d897}.my-officer-summary small{color:#87968f;font-size:10px;text-align:right}
.my-officer-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px 16px;align-items:start;justify-items:center;padding:4px 2px 12px}
.my-officer-card{position:relative!important;display:block!important;width:min(100%,236px)!important;aspect-ratio:467/1000!important;min-width:0!important;margin:0!important;padding:0!important;border:0!important;border-radius:18px!important;background:transparent!important;color:inherit!important;overflow:visible!important;cursor:pointer!important;isolation:isolate;transition:transform .16s ease,filter .16s ease!important}
.my-officer-card:hover{transform:translateY(-5px) scale(1.015);filter:drop-shadow(0 9px 18px #000a) brightness(1.05)}
.my-officer-card:focus-visible{outline:2px solid #e5c36e;outline-offset:5px}
.my-officer-card-layers{position:absolute;inset:0;overflow:hidden;border-radius:19px;background:linear-gradient(180deg,#d6c6a8 0%,#b7a27c 36%,#776948 100%);box-shadow:0 11px 24px #0009}
.my-officer-portrait{position:absolute;z-index:1;left:11.5%;right:11.5%;top:8.8%;bottom:9.5%;overflow:hidden;border-radius:44% 44% 12% 12%/9% 9% 5% 5%;background:linear-gradient(180deg,#bfd3cb,#d9c7a0 50%,#927a55);display:flex;align-items:stretch;justify-content:center}
.my-officer-portrait .officer-svg{width:100%!important;height:100%!important;max-width:none!important;border:0!important;border-radius:0!important;box-shadow:none!important;transform:scale(1.45);transform-origin:50% 45%}
.my-officer-fallback-portrait{width:100%;height:100%;display:grid;place-content:center;gap:8px;background:linear-gradient(180deg,#2d6c61,#274039);color:#f5e9c7}.my-officer-fallback-portrait b{font:900 78px/1 Georgia,serif}.my-officer-fallback-portrait span{font-size:12px;letter-spacing:.12em}
.my-officer-frame{position:absolute;z-index:2;inset:0;width:100%;height:100%;object-fit:contain;pointer-events:none;user-select:none;filter:drop-shadow(0 2px 1px #5a351dcc)}
.my-officer-info{position:absolute;z-index:3;inset:0;pointer-events:none}
.my-officer-troop-icon{position:absolute;left:50%;top:2.1%;transform:translateX(-50%);width:18%;aspect-ratio:1;border-radius:50%;display:grid;place-items:center;color:#fff5cf;text-shadow:0 1px 3px #001b12,0 0 7px #8fffc3;font:900 clamp(15px,1.8vw,24px)/1 Georgia,'Noto Serif KR',serif}
.my-officer-info-bottom{position:absolute;left:13%;right:13%;bottom:5.8%;min-height:23%;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;padding:21% 5% 1.5%;box-sizing:border-box;background:linear-gradient(180deg,transparent 0%,rgba(17,34,28,.08) 12%,rgba(12,29,23,.84) 40%,rgba(8,18,15,.94) 100%);clip-path:polygon(0 14%,100% 14%,94% 100%,6% 100%);text-align:center;text-shadow:0 1px 2px #000}
.my-officer-office{font:800 9px/1.1 'Noto Serif KR',serif;color:#9fd9bc;letter-spacing:.08em}.my-officer-name{margin-top:3px;max-width:100%;font:900 clamp(13px,1.35vw,18px)/1.12 'Noto Serif KR','Nanum Myeongjo',serif;color:#ffe6a8;white-space:normal;word-break:keep-all}.my-officer-region{margin-top:3px;font-size:8px;color:#b6c2bc;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
.my-officer-stats{width:100%;margin-top:5px;padding-top:5px;border-top:1px solid #bd9b5355;display:grid;grid-template-columns:1fr 1fr;gap:2px 6px;font-size:8px;color:#bdc8c2}.my-officer-stats span{display:flex;justify-content:space-between;gap:4px}.my-officer-stats b{color:#f4d27f;font-variant-numeric:tabular-nums}
.my-officer-empty,.my-officer-loading{margin:30px 3px;padding:34px;border:1px dashed #6c694e;border-radius:8px;text-align:center;color:#b8c1bb;background:#ffffff05}
@media(max-width:940px){.my-officer-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.my-officer-card{width:min(100%,225px)!important}}
@media(max-width:700px){#personnelListDialog.personnel-owned-dialog{width:calc(100vw - 12px)}.personnel-owned-dialog .personnel-shell{padding:14px 12px}.my-officer-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 9px}.my-officer-summary{display:grid}.my-officer-summary small{text-align:left}.my-officer-card{width:min(100%,210px)!important}.my-officer-name{font-size:13px}.my-officer-info-bottom{left:11%;right:11%;bottom:5%}}
@media(max-width:420px){.my-officer-grid{grid-template-columns:1fr}.my-officer-card{width:210px!important}}
@media(prefers-reduced-motion:reduce){.my-officer-card{transition:none!important}}
